# Copy to .env.local for local overrides, and set the same variable in Vercel
# (Project Settings > Environment Variables, Production).

# Public base URL of the site, no trailing slash. Used as metadataBase for
# Open Graph and Twitter images, canonical links, sitemap.xml and robots.txt.
# Without it: Vercel deployments use the project's production domain, and
# local builds use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
